rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 't.suphawat.mua@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'school_name', 'classroom_responsible', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['teacher', 'admin'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
             (!('school_name' in data) || (data.school_name is string && data.school_name.size() <= 200)) &&
             (!('classroom_responsible' in data) || (data.classroom_responsible is string && data.classroom_responsible.size() <= 100));
    }

    function isValidClassroom(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId']) &&
             data.keys().hasOnly(['id', 'name', 'level', 'academic_year', 'homeroom_teacher', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             (!('level' in data) || (data.level is string && data.level.size() <= 100)) &&
             (!('academic_year' in data) || (data.academic_year is string && data.academic_year.size() <= 20)) &&
             (!('homeroom_teacher' in data) || (data.homeroom_teacher is string && data.homeroom_teacher.size() <= 150));
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'student_no', 'name', 'student_code', 'ownerId']) &&
             data.keys().hasOnly(['id', 'student_no', 'name', 'student_code', 'classroom_id', 'classroom', 'gender', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.student_no is number && data.student_no >= 1 && data.student_no <= 200 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.student_code is string && data.student_code.size() > 0 && data.student_code.size() <= 30 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             (!('gender' in data) || data.gender in ['ชาย', 'หญิง']) &&
             (!('classroom_id' in data) || (data.classroom_id is string && data.classroom_id.size() <= 128)) &&
             (!('classroom' in data) || (data.classroom is string && data.classroom.size() <= 100));
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'credit', 'ownerId']) &&
             data.keys().hasOnly(['id', 'name', 'code', 'credit', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 30 &&
             data.credit is number && data.credit >= 0 && data.credit <= 20 &&
             data.ownerId is string && data.ownerId.size() <= 128;
    }

    function isValidTerm(data) {
      return data.keys().hasAll(['id', 'name', 'academic_year', 'max_score', 'ownerId']) &&
             data.keys().hasOnly(['id', 'name', 'academic_year', 'max_score', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.academic_year is string && data.academic_year.size() <= 20 &&
             data.max_score is number && data.max_score >= 1 && data.max_score <= 200 &&
             data.ownerId is string && data.ownerId.size() <= 128;
    }

    function isValidScoreItem(data) {
      return data.keys().hasAll(['id', 'subject_id', 'term_id', 'name', 'max_score', 'ownerId']) &&
             data.keys().hasOnly(['id', 'subject_id', 'term_id', 'name', 'max_score', 'category', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.subject_id is string && data.subject_id.size() <= 128 &&
             data.term_id is string && data.term_id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.max_score is number && data.max_score >= 0 && data.max_score <= 200 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             (!('category' in data) || data.category in ['regular', 'midterm', 'final']);
    }

    function isValidScore(data) {
      return data.keys().hasAll(['id', 'student_id', 'score_item_id', 'status', 'ownerId']) &&
             data.keys().hasOnly(['id', 'student_id', 'score_item_id', 'score', 'status', 'note', 'ownerId', 'updated_at', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.student_id is string && data.student_id.size() <= 128 &&
             data.score_item_id is string && data.score_item_id.size() <= 128 &&
             data.status in ['normal', 'absent', 'missing'] &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             (!('score' in data) || data.score == null || (data.score is number && data.score >= 0 && data.score <= 200)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 250));
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['id', 'student_id', 'student_name', 'type', 'title', 'academic_year', 'ownerId']) &&
             data.keys().hasOnly(['id', 'student_id', 'student_name', 'student_code', 'classroom_id', 'classroom_name', 'type', 'title', 'subtitle', 'subject_name', 'academic_year', 'issue_date', 'school_name', 'homeroom_teacher', 'principal_name', 'theme_color', 'notes', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.student_id is string && data.student_id.size() <= 128 &&
             data.student_name is string && data.student_name.size() > 0 && data.student_name.size() <= 150 &&
             data.type in ['academic_excellence', 'top_subject', 'outstanding_improvement', 'desirable_conduct', 'student_activity', 'custom'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.academic_year is string && data.academic_year.size() <= 20 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             (!('student_code' in data) || (data.student_code is string && data.student_code.size() <= 30)) &&
             (!('classroom_id' in data) || (data.classroom_id is string && data.classroom_id.size() <= 128)) &&
             (!('classroom_name' in data) || (data.classroom_name is string && data.classroom_name.size() <= 100)) &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 250)) &&
             (!('subject_name' in data) || (data.subject_name is string && data.subject_name.size() <= 150)) &&
             (!('issue_date' in data) || (data.issue_date is string && data.issue_date.size() <= 100)) &&
             (!('school_name' in data) || (data.school_name is string && data.school_name.size() <= 200)) &&
             (!('homeroom_teacher' in data) || (data.homeroom_teacher is string && data.homeroom_teacher.size() <= 150)) &&
             (!('principal_name' in data) || (data.principal_name is string && data.principal_name.size() <= 150)) &&
             (!('theme_color' in data) || data.theme_color in ['gold', 'blue', 'emerald', 'crimson']) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 250));
    }

    function isValidNotificationLog(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'message', 'recipient_group', 'status', 'timestamp', 'ownerId']) &&
             data.keys().hasOnly(['id', 'type', 'title', 'message', 'recipient_group', 'classroom', 'subject_name', 'term_name', 'status', 'timestamp', 'student_count', 'error_message', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.type in ['score_saved', 'midterm_final', 'low_score_alert', 'missing_work_alert', 'remedial_scheduled', 'remedial_passed', 'custom_broadcast', 'test_ping'] &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             data.recipient_group is string && data.recipient_group.size() <= 150 &&
             data.status in ['success', 'failed', 'simulated'] &&
             data.timestamp is string &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             (!('classroom' in data) || (data.classroom is string && data.classroom.size() <= 100)) &&
             (!('subject_name' in data) || (data.subject_name is string && data.subject_name.size() <= 150)) &&
             (!('term_name' in data) || (data.term_name is string && data.term_name.size() <= 100)) &&
             (!('student_count' in data) || (data.student_count is number)) &&
             (!('error_message' in data) || (data.error_message is string && data.error_message.size() <= 500));
    }

    function isValidRemedialRecord(data) {
      return data.keys().hasAll(['id', 'student_id', 'student_name', 'subject_id', 'subject_name', 'term_id', 'original_score', 'max_score', 'status', 'ownerId']) &&
             data.keys().hasOnly(['id', 'student_id', 'student_name', 'student_code', 'student_no', 'classroom_id', 'classroom_name', 'subject_id', 'subject_name', 'subject_code', 'term_id', 'term_name', 'score_item_id', 'score_item_name', 'indicator_or_standard', 'original_score', 'max_score', 'target_passing_score', 'learning_defect', 'remedial_method', 'remedial_method_detail', 'remedial_date', 'remedial_duration_hours', 're_exam_date', 're_exam_score', 'final_recorded_score', 'status', 'teacher_notes', 'remedial_round', 'synced_to_gradebook', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.student_id is string && data.student_id.size() <= 128 &&
             data.student_name is string && data.student_name.size() > 0 && data.student_name.size() <= 150 &&
             data.subject_id is string && data.subject_id.size() <= 128 &&
             data.subject_name is string && data.subject_name.size() > 0 && data.subject_name.size() <= 150 &&
             data.term_id is string && data.term_id.size() <= 128 &&
             data.original_score is number &&
             data.max_score is number &&
             data.status in ['pending', 'in_progress', 're_exam_scheduled', 'passed', 'failed'] &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             (!('student_code' in data) || (data.student_code is string && data.student_code.size() <= 30)) &&
             (!('student_no' in data) || (data.student_no is number)) &&
             (!('classroom_id' in data) || (data.classroom_id is string && data.classroom_id.size() <= 128)) &&
             (!('classroom_name' in data) || (data.classroom_name is string && data.classroom_name.size() <= 100)) &&
             (!('subject_code' in data) || (data.subject_code is string && data.subject_code.size() <= 30)) &&
             (!('term_name' in data) || (data.term_name is string && data.term_name.size() <= 100)) &&
             (!('score_item_id' in data) || (data.score_item_id is string && data.score_item_id.size() <= 128)) &&
             (!('score_item_name' in data) || (data.score_item_name is string && data.score_item_name.size() <= 150)) &&
             (!('indicator_or_standard' in data) || (data.indicator_or_standard is string && data.indicator_or_standard.size() <= 200)) &&
             (!('target_passing_score' in data) || (data.target_passing_score is number)) &&
             (!('learning_defect' in data) || (data.learning_defect is string && data.learning_defect.size() <= 300)) &&
             (!('remedial_method' in data) || data.remedial_method in ['individual_tutoring', 'remedial_worksheet', 'peer_tutoring', 'digital_learning', 'project_assignment', 'other']) &&
             (!('remedial_method_detail' in data) || (data.remedial_method_detail is string && data.remedial_method_detail.size() <= 500)) &&
             (!('remedial_date' in data) || (data.remedial_date is string && data.remedial_date.size() <= 50)) &&
             (!('remedial_duration_hours' in data) || (data.remedial_duration_hours is number)) &&
             (!('re_exam_date' in data) || (data.re_exam_date is string && data.re_exam_date.size() <= 50)) &&
             (!('re_exam_score' in data) || data.re_exam_score == null || (data.re_exam_score is number)) &&
             (!('final_recorded_score' in data) || data.final_recorded_score == null || (data.final_recorded_score is number)) &&
             (!('teacher_notes' in data) || (data.teacher_notes is string && data.teacher_notes.size() <= 500)) &&
             (!('remedial_round' in data) || (data.remedial_round is number)) &&
             (!('synced_to_gradebook' in data) || (data.synced_to_gradebook is bool));
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isVerifiedUser() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'school_name', 'classroom_responsible', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Classrooms collection
    match /classrooms/{classroomId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(classroomId) && isValidClassroom(incoming());
      allow update: if isVerifiedUser() && isValidId(classroomId) && isValidClassroom(incoming());
      allow delete: if isVerifiedUser() && isValidId(classroomId);
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(studentId) && isValidStudent(incoming());
      allow update: if isVerifiedUser() && isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isVerifiedUser() && isValidId(studentId);
    }

    // Subjects collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(subjectId) && isValidSubject(incoming());
      allow update: if isVerifiedUser() && isValidId(subjectId) && isValidSubject(incoming());
      allow delete: if isVerifiedUser() && isValidId(subjectId);
    }

    // Terms collection
    match /terms/{termId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(termId) && isValidTerm(incoming());
      allow update: if isVerifiedUser() && isValidId(termId) && isValidTerm(incoming());
      allow delete: if isVerifiedUser() && isValidId(termId);
    }

    // Score items collection
    match /score_items/{scoreItemId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(scoreItemId) && isValidScoreItem(incoming());
      allow update: if isVerifiedUser() && isValidId(scoreItemId) && isValidScoreItem(incoming());
      allow delete: if isVerifiedUser() && isValidId(scoreItemId);
    }

    // Scores collection
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(scoreId) && isValidScore(incoming());
      allow update: if isVerifiedUser() && isValidId(scoreId) && isValidScore(incoming());
      allow delete: if isVerifiedUser() && isValidId(scoreId);
    }

    // Certificates collection
    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(certificateId) && isValidCertificate(incoming());
      allow update: if isVerifiedUser() && isValidId(certificateId) && isValidCertificate(incoming());
      allow delete: if isVerifiedUser() && isValidId(certificateId);
    }

    // Notification logs collection
    match /notification_logs/{logId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(logId) && isValidNotificationLog(incoming());
      allow update: if isVerifiedUser() && isValidId(logId) && isValidNotificationLog(incoming());
      allow delete: if isVerifiedUser() && isValidId(logId);
    }

    // Remedial records collection
    match /remedial_records/{recordId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidId(recordId) && isValidRemedialRecord(incoming());
      allow update: if isVerifiedUser() && isValidId(recordId) && isValidRemedialRecord(incoming());
      allow delete: if isVerifiedUser() && isValidId(recordId);
    }

    // School settings collection
    match /school_settings/{settingsId} {
      allow read: if true;
      allow write: if isVerifiedUser() && isValidId(settingsId);
    }
  }
}
