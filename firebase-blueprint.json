{
  "entities": {
    "User": {
      "title": "User",
      "description": "Teacher or administrator user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "school_name": { "type": "string", "maxLength": 200 },
        "classroom_responsible": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "Classroom managed by teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "maxLength": 100 },
        "academic_year": { "type": "string", "maxLength": 20 },
        "homeroom_teacher": { "type": "string", "maxLength": 150 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record with student ID and room assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "student_no": { "type": "number" },
        "name": { "type": "string", "maxLength": 150 },
        "student_code": { "type": "string", "maxLength": 30 },
        "classroom_id": { "type": "string", "maxLength": 128 },
        "classroom": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["ชาย", "หญิง"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "student_no", "name", "student_code", "ownerId"]
    },
    "Subject": {
      "title": "Subject",
      "description": "School course curriculum subject",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "code": { "type": "string", "maxLength": 30 },
        "credit": { "type": "number" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "code", "credit", "ownerId"]
    },
    "Term": {
      "title": "Term",
      "description": "Academic semester term definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "academic_year": { "type": "string", "maxLength": 20 },
        "max_score": { "type": "number" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "academic_year", "max_score", "ownerId"]
    },
    "ScoreItem": {
      "title": "ScoreItem",
      "description": "Individual assignment, midterm or final examination item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "subject_id": { "type": "string", "maxLength": 128 },
        "term_id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "max_score": { "type": "number" },
        "category": { "type": "string", "enum": ["regular", "midterm", "final"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "subject_id", "term_id", "name", "max_score", "ownerId"]
    },
    "Score": {
      "title": "Score",
      "description": "Score record for student assignment or exam",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "student_id": { "type": "string", "maxLength": 128 },
        "score_item_id": { "type": "string", "maxLength": 128 },
        "score": { "type": "number" },
        "status": { "type": "string", "enum": ["normal", "absent", "missing"] },
        "note": { "type": "string", "maxLength": 250 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "updated_at": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "student_id", "score_item_id", "status", "ownerId"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Student certificates, awards, and honor roll recognitions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "student_id": { "type": "string", "maxLength": 128 },
        "student_name": { "type": "string", "maxLength": 150 },
        "student_code": { "type": "string", "maxLength": 30 },
        "classroom_id": { "type": "string", "maxLength": 128 },
        "classroom_name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["academic_excellence", "top_subject", "outstanding_improvement", "desirable_conduct", "student_activity", "custom"] },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 250 },
        "subject_name": { "type": "string", "maxLength": 150 },
        "academic_year": { "type": "string", "maxLength": 20 },
        "issue_date": { "type": "string", "maxLength": 100 },
        "school_name": { "type": "string", "maxLength": 200 },
        "homeroom_teacher": { "type": "string", "maxLength": 150 },
        "principal_name": { "type": "string", "maxLength": 150 },
        "theme_color": { "type": "string", "enum": ["gold", "blue", "emerald", "crimson"] },
        "notes": { "type": "string", "maxLength": 250 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "student_id", "student_name", "type", "title", "academic_year", "ownerId"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Log records of notifications sent to parents or groups",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["score_saved", "midterm_final", "low_score_alert", "missing_work_alert", "custom_broadcast", "test_ping"] },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "recipient_group": { "type": "string", "maxLength": 150 },
        "classroom": { "type": "string", "maxLength": 100 },
        "subject_name": { "type": "string", "maxLength": 150 },
        "term_name": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["success", "failed", "simulated"] },
        "timestamp": { "type": "string" },
        "student_count": { "type": "number" },
        "error_message": { "type": "string", "maxLength": 500 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "message", "recipient_group", "status", "timestamp", "ownerId"]
    },
    "RemedialRecord": {
      "title": "RemedialRecord",
      "description": "Remedial instruction and re-examination tracking records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "student_id": { "type": "string", "maxLength": 128 },
        "student_name": { "type": "string", "maxLength": 150 },
        "student_code": { "type": "string", "maxLength": 30 },
        "student_no": { "type": "number" },
        "classroom_id": { "type": "string", "maxLength": 128 },
        "classroom_name": { "type": "string", "maxLength": 100 },
        "subject_id": { "type": "string", "maxLength": 128 },
        "subject_name": { "type": "string", "maxLength": 150 },
        "subject_code": { "type": "string", "maxLength": 30 },
        "term_id": { "type": "string", "maxLength": 128 },
        "term_name": { "type": "string", "maxLength": 100 },
        "score_item_id": { "type": "string", "maxLength": 128 },
        "score_item_name": { "type": "string", "maxLength": 150 },
        "indicator_or_standard": { "type": "string", "maxLength": 200 },
        "original_score": { "type": "number" },
        "max_score": { "type": "number" },
        "target_passing_score": { "type": "number" },
        "learning_defect": { "type": "string", "maxLength": 300 },
        "remedial_method": { "type": "string", "enum": ["individual_tutoring", "remedial_worksheet", "peer_tutoring", "digital_learning", "project_assignment", "other"] },
        "remedial_method_detail": { "type": "string", "maxLength": 500 },
        "remedial_date": { "type": "string", "maxLength": 50 },
        "remedial_duration_hours": { "type": "number" },
        "re_exam_date": { "type": "string", "maxLength": 50 },
        "re_exam_score": { "type": "number" },
        "final_recorded_score": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "re_exam_scheduled", "passed", "failed"] },
        "teacher_notes": { "type": "string", "maxLength": 500 },
        "remedial_round": { "type": "number" },
        "synced_to_gradebook": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "student_id", "student_name", "subject_id", "subject_name", "term_id", "original_score", "max_score", "status", "ownerId"]
    },
    "SchoolSettings": {
      "title": "SchoolSettings",
      "description": "School profile, branding, logo, and director configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "school_name": { "type": "string", "maxLength": 200 },
        "school_name_en": { "type": "string", "maxLength": 200 },
        "affiliation": { "type": "string", "maxLength": 200 },
        "ministry": { "type": "string", "maxLength": 200 },
        "school_code": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 250 },
        "subdistrict": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "postal_code": { "type": "string", "maxLength": 20 },
        "phone_number": { "type": "string", "maxLength": 50 },
        "website_or_email": { "type": "string", "maxLength": 150 },
        "director_name": { "type": "string", "maxLength": 150 },
        "director_title": { "type": "string", "maxLength": 150 },
        "director_signature_url": { "type": "string" },
        "academic_year": { "type": "string", "maxLength": 20 },
        "logo_url": { "type": "string" },
        "logo_type": { "type": "string", "enum": ["garuda", "seal", "education", "custom", "none"] },
        "document_header_title": { "type": "string", "maxLength": 200 },
        "certificate_header_text": { "type": "string", "maxLength": 200 },
        "teacher_name": { "type": "string", "maxLength": 150 },
        "teacher_signature_url": { "type": "string" },
        "theme_accent_color": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string" }
      },
      "required": ["school_name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile and preferences for logged in teachers"
    },
    "/classrooms/{classroomId}": {
      "schema": "Classroom",
      "description": "Classrooms created and managed by teachers"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student roster with student numbers and identification codes"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Curriculum subjects"
    },
    "/terms/{termId}": {
      "schema": "Term",
      "description": "Academic terms"
    },
    "/score_items/{scoreItemId}": {
      "schema": "ScoreItem",
      "description": "Evaluation items and exams"
    },
    "/scores/{scoreId}": {
      "schema": "Score",
      "description": "Student score records"
    },
    "/certificates/{certificateId}": {
      "schema": "Certificate",
      "description": "Certificates and awards issued to students"
    },
    "/notification_logs/{logId}": {
      "schema": "NotificationLog",
      "description": "Logs of parent messages and LINE notifications"
    },
    "/remedial_records/{recordId}": {
      "schema": "RemedialRecord",
      "description": "Records of remedial teaching and re-examinations"
    },
    "/school_settings/{settingsId}": {
      "schema": "SchoolSettings",
      "description": "School settings including name, logo, director, and address"
    }
  }
}
